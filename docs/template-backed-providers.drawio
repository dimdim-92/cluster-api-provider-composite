        <mxCell id="l-sources" value="&lt;b&gt;Source templates&lt;/b&gt;&lt;br&gt;InfraClusterTemplate + KCT&lt;br&gt;Reusable catalog configuration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d6f0ea;strokeColor=#0f766e;spacing=22;fontSize=22;" vertex="1" parent="l-graph">
          <mxGeometry x="40" y="90" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l-profile" value="&lt;b&gt;CompositeProviderTemplate&lt;/b&gt;&lt;br&gt;Immutable regional revision&lt;br&gt;Cluster-scoped · globally protected" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;spacing=22;fontSize=22;" vertex="1" parent="l-graph">
          <mxGeometry x="620" y="90" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l-cct" value="&lt;b&gt;CompositeProvider&lt;/b&gt;&lt;br&gt;Namespaced attachment&lt;br&gt;templateRef + clusterRef" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=22;fontSize=21;" vertex="1" parent="l-graph">
          <mxGeometry x="40" y="410" width="380" height="145" as="geometry" />
        </mxCell>
        <mxCell id="l-cc" value="&lt;b&gt;CompositeCluster / cluster-demo-infra&lt;/b&gt;&lt;br&gt;Attachment bindings + finalizer&lt;br&gt;Provider-free spec" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;spacing=22;fontSize=22;" vertex="1" parent="l-graph">
          <mxGeometry x="600" y="410" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="l-cluster" value="&lt;b&gt;CAPI Cluster / cluster-demo&lt;/b&gt;&lt;br&gt;Workload lifecycle owner&lt;br&gt;Native workers + control plane" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=22;fontSize=22;" vertex="1" parent="l-graph">
          <mxGeometry x="40" y="790" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l-generated" value="&lt;b&gt;Generated regional children&lt;/b&gt;&lt;br&gt;Native InfraClusters&lt;br&gt;+ rendered bootstrap templates&lt;br&gt;Dual ownerRefs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;spacing=22;fontSize=22;" vertex="1" parent="l-graph">
          <mxGeometry x="600" y="790" width="460" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l-protection" value="&lt;b&gt;Global catalog reference protection&lt;/b&gt;&lt;br&gt;CompositeProvider refs + cluster attachment pins, across all namespaces&lt;br&gt;Unreadable references retain protection; checks are not transactional.&lt;br&gt;No ClusterTemplate references; sources retained by administrators." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=24;fontSize=21;" vertex="1" parent="l-graph">
          <mxGeometry x="40" y="1100" width="1020" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l-bindings" value="&lt;b&gt;Current attachment bindings / source pins&lt;/b&gt;&lt;br&gt;Provider + cluster + template UIDs; source UID/generation&lt;br&gt;Historical cluster provider-bindings unsupported" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=24;fontSize=22;" vertex="1" parent="l-graph">
          <mxGeometry x="40" y="1340" width="1020" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l-teardown" value="Normal deletion through CAPI" style="swimlane;html=1;horizontal=1;startSize=60;container=1;collapsible=0;rounded=1;arcSize=5;fillColor=#ffedd5;swimlaneFillColor=#ffffff;strokeColor=#c2410c;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="350" width="1030" height="1530" as="geometry" />
        </mxCell>
        <mxCell id="l-t1" value="&lt;b&gt;1 · Request Cluster deletion&lt;/b&gt;&lt;br&gt;Verify the actual owning resource" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=20;fontSize=23;" vertex="1" parent="l-teardown">
          <mxGeometry x="40" y="90" width="590" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l-t2" value="&lt;b&gt;2 · Native workload teardown&lt;/b&gt;&lt;br&gt;CAPI coordinates workers + control plane&lt;br&gt;Native providers clean up their resources" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=20;fontSize=22;" vertex="1" parent="l-teardown">
          <mxGeometry x="40" y="310" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l-t3" value="&lt;b&gt;3 · Delete owned InfraClusters&lt;/b&gt;&lt;br&gt;Use persisted identities + guarded deletes&lt;br&gt;Native finalizers drive cloud cleanup" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;spacing=20;fontSize=22;" vertex="1" parent="l-teardown">
          <mxGeometry x="40" y="550" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l-gone" value="&lt;b&gt;All InfraClusters&lt;br&gt;confirmed absent?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=22;" vertex="1" parent="l-teardown">
          <mxGeometry x="150" y="730" width="370" height="180" as="geometry" />
        </mxCell>
        <mxCell id="l-t4" value="&lt;b&gt;4 · Delete rendered bootstrap templates&lt;/b&gt;&lt;br&gt;Only after all native infrastructure is absent&lt;br&gt;Use persisted names + ownership guards" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;spacing=20;fontSize=22;" vertex="1" parent="l-teardown">
          <mxGeometry x="40" y="970" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l-t5" value="&lt;b&gt;5 · Release Composite finalizer&lt;/b&gt;&lt;br&gt;Confirm bootstrap absence first&lt;br&gt;Then finish CompositeCluster deletion" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;spacing=20;fontSize=22;" vertex="1" parent="l-teardown">
          <mxGeometry x="40" y="1180" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l-t6" value="&lt;b&gt;6 · Recheck catalog dependencies&lt;/b&gt;&lt;br&gt;Release protection only when unused" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;spacing=20;fontSize=22;" vertex="1" parent="l-teardown">
          <mxGeometry x="40" y="1390" width="590" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l-lost" value="&lt;b&gt;Missing history&lt;/b&gt;&lt;br&gt;Stop unsafe writes.&lt;br&gt;Restore verified bindings.&lt;br&gt;Names ≠ ownership." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;spacing=20;fontSize=21;" vertex="1" parent="l-teardown">
          <mxGeometry x="700" y="100" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="l-wait" value="&lt;b&gt;Wait / retry&lt;/b&gt;&lt;br&gt;Keep KCTs + finalizer&lt;br&gt;API unavailable ≠ absent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;spacing=20;fontSize=20;" vertex="1" parent="l-teardown">
          <mxGeometry x="700" y="735" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="l-missing-source" value="&lt;b&gt;Missing source&lt;/b&gt;&lt;br&gt;Teardown still uses&lt;br&gt;persisted identities.&lt;br&gt;Never rebuild pins&lt;br&gt;from current defaults." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=20;fontSize=21;" vertex="1" parent="l-teardown">
          <mxGeometry x="700" y="1190" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="l-pin-note" value="&lt;b&gt;Pinned attachment / source identities&lt;/b&gt;&lt;br&gt;Provider, cluster and template UIDs; each source UID + generation.&lt;br&gt;Spec edits or recreation block bound consumers; metadata edits are allowed.&lt;br&gt;No content hash, automatic rebind or legacy-pin conversion." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=24;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1940" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l-guard-note" value="&lt;b&gt;Ownership guards&lt;/b&gt;&lt;br&gt;Direct reads · dual ownerRefs · actual Cluster label&lt;br&gt;UID / resourceVersion checks on apply and delete&lt;br&gt;Foreign objects or replaced UIDs must never be adopted or deleted." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=24;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1940" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l-footer" value="Source templates are read-only, administrator-retained inputs with no Composite finalizer. Native workers keep their CAPI ownership chain." style="text;html=1;align=left;fontSize=18;fontColor=#64748b;" vertex="1" parent="1">
