        </mxCell>
        <mxCell id="r-catalog" value="A · Catalog revision" style="swimlane;html=1;horizontal=1;startSize=60;container=1;collapsible=0;rounded=1;arcSize=5;fillColor=#ede9fe;swimlaneFillColor=#faf8ff;strokeColor=#7c3aed;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="580" height="1470" as="geometry" />
        </mxCell>
        <mxCell id="r-a1" value="&lt;b&gt;A1 · Admit native templates&lt;/b&gt;&lt;br&gt;Native CRDs + webhooks&lt;br&gt;Defaults in spec.template.spec" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d6f0ea;strokeColor=#0f766e;spacing=22;fontSize=22;" vertex="1" parent="r-catalog">
          <mxGeometry x="40" y="100" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r-a2" value="&lt;b&gt;A2 · Admit immutable profile&lt;/b&gt;&lt;br&gt;Identity + target kind + policy&lt;br&gt;Required native template references" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;spacing=22;fontSize=22;" vertex="1" parent="r-catalog">
          <mxGeometry x="40" y="360" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r-a3" value="&lt;b&gt;A3 · Resolve sources · E1&lt;/b&gt;&lt;br&gt;Explicit namespace + served version&lt;br&gt;Check shape, target kind and policy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;spacing=22;fontSize=21;" vertex="1" parent="r-catalog">
          <mxGeometry x="40" y="620" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r-a4" value="&lt;b&gt;A4 · Validate resolved defaults&lt;/b&gt;&lt;br&gt;Exact JSON + effective policy&lt;br&gt;No catalog content hash" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=22;fontSize=22;" vertex="1" parent="r-catalog">
          <mxGeometry x="40" y="880" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r-a5" value="&lt;b&gt;A5 · Publish configuration status&lt;/b&gt;&lt;br&gt;ConfigurationValid&lt;br&gt;Current observedGeneration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;spacing=22;fontSize=22;" vertex="1" parent="r-catalog">
          <mxGeometry x="40" y="1140" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r-protection" value="&lt;b&gt;Global catalog protection&lt;/b&gt;&lt;br&gt;Provider refs + cluster attachment pins" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=20;fontSize=19;" vertex="1" parent="r-catalog">
          <mxGeometry x="40" y="1350" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r-consumer" value="B · CompositeCluster reconcile" style="swimlane;html=1;horizontal=1;startSize=60;container=1;collapsible=0;rounded=1;arcSize=5;fillColor=#dbeafe;swimlaneFillColor=#ffffff;strokeColor=#2563eb;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="350" width="1040" height="1470" as="geometry" />
        </mxCell>
        <mxCell id="r-b1" value="&lt;b&gt;B1 · Check scope&lt;/b&gt;&lt;br&gt;Pause / watch scope&lt;br&gt;External management&lt;br&gt;Owning Cluster UID" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="40" y="100" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b2" value="&lt;b&gt;B2 · Resolve · E1&lt;/b&gt;&lt;br&gt;CompositeProviders + templates&lt;br&gt;Check attachment/source pins&lt;br&gt;Read current bindings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="380" y="100" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b3" value="&lt;b&gt;B3 · Merge · E2&lt;/b&gt;&lt;br&gt;Defaults + overrides&lt;br&gt;Apply endpoint&lt;br&gt;Enforce override policy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="720" y="100" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b4" value="&lt;b&gt;B4 · Preflight · E2&lt;/b&gt;&lt;br&gt;Unique GroupKind / name&lt;br&gt;Canonical lookup present&lt;br&gt;Ownership + history" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="40" y="500" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b5" value="&lt;b&gt;B5 · Bind identity&lt;/b&gt;&lt;br&gt;Cluster bindings + finalizer&lt;br&gt;Provider pins + finalizer&lt;br&gt;Before child writes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="380" y="500" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b6" value="&lt;b&gt;B6 · Dry-run · E3&lt;/b&gt;&lt;br&gt;Final rendered CRs&lt;br&gt;Installed native schemas&lt;br&gt;Consumer namespace" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="720" y="500" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b7" value="&lt;b&gt;B7 · Apply InfraCluster&lt;/b&gt;&lt;br&gt;Create / guarded SSA&lt;br&gt;Dual ownerRefs&lt;br&gt;UID + resourceVersion" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="40" y="900" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b8" value="&lt;b&gt;B8 · Apply bootstrap&lt;/b&gt;&lt;br&gt;This child applied&lt;br&gt;+ endpoint available&lt;br&gt;Other regions may wait" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="380" y="900" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-b9" value="&lt;b&gt;B9 · Observe once&lt;/b&gt;&lt;br&gt;Per-provider health&lt;br&gt;Empty cluster independently ready&lt;br&gt;Initialization latched" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;spacing=18;fontSize=20;" vertex="1" parent="r-consumer">
          <mxGeometry x="720" y="900" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r-identity-note" value="&lt;b&gt;Bindings are identity; status is observation&lt;/b&gt;&lt;br&gt;Validate the complete record before new bindings or child writes.&lt;br&gt;Names, labels and stale status never authorize adoption.&lt;br&gt;Observe generations · settle 30 s · poll native children every 5 min." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=24;fontSize=21;" vertex="1" parent="r-consumer">
          <mxGeometry x="40" y="1220" width="960" height="210" as="geometry" />
        </mxCell>
        <mxCell id="r-errors" value="Failure behavior" style="swimlane;html=1;horizontal=1;startSize=60;container=1;collapsible=0;rounded=1;arcSize=5;fillColor=#fee2e2;swimlaneFillColor=#ffffff;strokeColor=#dc2626;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1910" y="350" width="430" height="1470" as="geometry" />
        </mxCell>
        <mxCell id="r-e1" value="&lt;b&gt;E1 · Source unavailable&lt;/b&gt;&lt;br&gt;Missing / changed UID or generation&lt;br&gt;Unsupported shape / version&lt;br&gt;Retain verified children" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;spacing=22;fontSize=21;" vertex="1" parent="r-errors">
          <mxGeometry x="35" y="100" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r-e2" value="&lt;b&gt;E2 · Unsafe composition&lt;/b&gt;&lt;br&gt;Forbidden override&lt;br&gt;Identity / ownership conflict&lt;br&gt;Missing history → no adoption" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;spacing=22;fontSize=21;" vertex="1" parent="r-errors">
          <mxGeometry x="35" y="520" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r-e3" value="&lt;b&gt;E3 · Target / API failure&lt;/b&gt;&lt;br&gt;Report bounded diagnostics&lt;br&gt;Preserve errors; retry safely&lt;br&gt;API failure ≠ child absence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;spacing=22;fontSize=21;" vertex="1" parent="r-errors">
          <mxGeometry x="35" y="940" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r-safe-note" value="&lt;b&gt;Safe diagnostics&lt;/b&gt;&lt;br&gt;No payload / credential dumps&lt;br&gt;No invented provider history" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=20;fontSize=20;" vertex="1" parent="r-errors">
          <mxGeometry x="35" y="1310" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r-source-note" value="&lt;b&gt;Extract configuration only&lt;/b&gt;&lt;br&gt;spec.template.spec → target spec&lt;br&gt;Do not copy source metadata or status." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=22;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60" y="1900" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r-merge-note" value="&lt;b&gt;Preserve merge semantics&lt;/b&gt;&lt;br&gt;Infra: JSON Merge Patch · exact numbers&lt;br&gt;Bootstrap: shared → defaults → overrides; named lists" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=22;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="820" y="1900" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r-validation-note" value="&lt;b&gt;Validation boundary&lt;/b&gt;&lt;br&gt;Admission / dry-run checks schema and policy.&lt;br&gt;Cloud access, networks and worker joins need live validation." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;spacing=22;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1900" width="760" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r-footer" value="Current attachment bindings pin provider, cluster and template UIDs plus source UID/generation. Historical cluster provider-bindings are unsupported." style="text;html=1;align=left;fontSize=18;fontColor=#64748b;" vertex="1" parent="1">
